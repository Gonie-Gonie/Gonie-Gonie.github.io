@article{publication-2021-1nbtoo1,
  title = {Stochastic Daylighting Model for Predictive Control in Large Open-space Building},
  author = {Jo, H. G. and Kim, Y. S. and Park, C. S.},
  year = {2021},
  journal = {Journal of the Architectural Institute of Korea, Vol. 37, No. 12, pp. 255-264.},
  doi = {10.5659/JAIK.2021.37.12.255},
  url = {https://www.aik.or.kr/pages_archive/aik_journal_list.vm?ncode=p002d},
  abstract = {Development  of  stochastic  daylighting  prediction  model  for  a  large  open-space  building  was  presented  in  this  paper.  The  daylit  prediction model  uses  solar  altitude  and  azimuth,  an  illuminance  value  at  a  reference  point  and  a  cloud  cover  and  predict  daylit  illuminances  at  sixteen workplane.  The  model  can  be  regarded  as  ‘virtual  sensor’  without  installing  actual  photosensor.  For  capturing  stochastic  characteristics  of daylit  luminous  indoor  environment,  Gaussian  process  was  used.  The  daylit  prediction  model  was  then  integrated  to  electric  lighting  control  of the  building.  The  optimal  lighting  control  variables  that  can  minimize  electric  lighting  power  consumption  while  satisfying  required illuminance  level  expressed  as  a  safety  margin  were  found.  Based  on  the  eight  days’  validation,  it  is  found  that  the  proposed  approach  could save  energy  by  12.3\%.  It  is  expected  that  this  stochastic  control  approach  could  be  applied  to  other  lighting  control  or  indoor  environmental control  system.},
  keywords = {model uncertainty; daylight prediction model; electric lighting control; gaussian process}
}

@inproceedings{publication-2021-dlwkuq,
  title = {Electric Lighting Control Considering Uncertainty of Daylighting Model prediction},
  author = {Jo, H. G. and Ra, S. J. and Kim, J. H. and Park, C. S.},
  year = {2021},
  booktitle = {Proceedings of the Fall Conference of the Architectural Institute of Korea, Vol. 41, No. 2, pp. 332-333. Fall Annual Conference of the Architectural Institute of Korea, 2021, October 27-30, 2021, Yeosu Expo Convention Center and Venezia Hotel, Yeosu, Republic of Korea; hybrid.},
  url = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE11024946},
  abstract = {It  has  been  widely  acknowledged  that  daylit  illuminance  at  work  plane  is  of  strong  stochastic  nature  and  thus  hard  to  accurately  predict.  In this  study,  the  authors  present  a  daylighting  prediction  model  that  can  account  for  the  aforementioned  stochastic  nature  using  Gaussian process  model.  The  model  can  quantify  uncertainty  in  daylit  illuminance  at  16  work  planes  of  a  given  target  building.  The  daylighting prediction  model  is  then  integrated  to  automatic  electric  lighting  control  that  can  switch  on/off  six  lighting  groups  in  the  building.  It  was found  that  the  integrated  control  could  save  lighting  energy  consumption  by  15.3\%  over  four  days  (Aug  9  Aug  12).},
  keywords = {electric lighting control; model uncertainty; indoor daylit prediction}
}

@inproceedings{publication-2021-chy62u,
  title = {Real-time Predictive Control Using Lumped Simulation Models for Cooling of a Building},
  author = {Ra, S. J. and Kim, J. H. and Kim, Y. S. and Jo, H. G. and Shin, H. S. and Park, C. S.},
  year = {2021},
  booktitle = {Proceedings of the Fall Conference of the Architectural Institute of Korea, Vol. 41, No. 2, pp. 323-324. Fall Annual Conference of the Architectural Institute of Korea, 2021, October 27-30, 2021, Yeosu Expo Convention Center and Venezia Hotel, Yeosu, Republic of Korea; hybrid.},
  url = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE11024942},
  abstract = {This  paper  presents  a  Model-Predictive  Control  (MPC)  study  applied  to  a  cooling  system  in  a  large  open-space  building.  The  authors developed  the  MPC  that  uses  minimal  inputs  based  on  a  set  of  machine  learning  models  for  direct-expansion  air  handling  unit  (DX-AHU). For  this  study,  the  authors  developed  an  DX-AHU  supply  air  temperature  prediction  model  and  indoor  temperature  prediction  models  for  9 air  conditioning  zones.  The  prediction  time  horizon  was  set  to  20-minute.  The  control  objective  is  to  minimize  the  energy  consumption  by DX-AHUs  while  keeping  an  average  indoor  temperature  less  than  27 .  It  was  found  that  the  developed  simulation  models  are  accurate °Cenough  and  the  could  save  significant  energy  by  21.4\%  compared  to  the  existing  control.},
  keywords = {machine learning; artificial neural network; lumped model; model predictive control; air handling unit}
}

@inproceedings{publication-2021-d8m8lg,
  title = {Prediction model of global horizontal irradiance using artificial neural network},
  author = {Kim, J. H. and Jo, H. G. and Kim, Y. S. and Shin, H. S. and Park, C. S.},
  year = {2021},
  booktitle = {Proceedings of the Spring Conference of the Architectural Institute of Korea, Vol. 41, No. 1, pp. 288-289. General Assembly \& Spring Annual Conference of AIK, 2021, April 21-23, 2021, International Convention Center Jeju and Jeju Booyoung Hotel \& Resort, Seogwipo, Republic of Korea.},
  url = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE10563701},
  abstract = {To  proper  control  of  electric  lighting  (e.g.  on/off,  multi-level,  dimming),  it  is  essential  to  predict  daylit  indoor  illuminance  at  the  workplane. For  the  use  of  the  Radiance-based  daylighting  simulation  tool,  solar  altitude,  solar  azimuth  and  Global  Horizontal  Irradiance  (GHI)  are required.  Rather  than  relying  on  the  measured  GHI  provided  in  off-line  from  a  nearby  weather  station,  this  study  presents  a  simplified method  to  directly  estimate  GHI  from  an  on-site  horizontal  illuminance.  For  this  purpose,  an  Artificial  Neural  Network  (ANN)  model  was developed  to  predict  GHI  with  data  of  solar  altitude,  solar  azimuth,  a  measured  illuminance,  and  cloud  cover.  It  is  found  that  the  ANN model  is  accurate  enough  (MBE:  2.4\%,  CVRMSE:  15.7\%).  This  proposed  model  will  be  integrated  to  daylit  prediction  model  and  on-line optimal  control  of  electric  lighting.},
  keywords = {global horizontal irradiance; illuminance; artificial neural network; daylighting prediction}
}

@inproceedings{publication-2021-c4kobl,
  title = {Real-time Model Predictive Control for Heating of a Factory Building},
  author = {Ra, S. J. and Shin, H. S. and Kim, Y. S. and Jo, H. G. and Kim, J. H. and Park, C. S.},
  year = {2021},
  booktitle = {Proceedings of the Spring Conference of the Architectural Institute of Korea, Vol. 41, No. 1, pp. 309-310. General Assembly \& Spring Annual Conference of AIK, 2021, April 21-23, 2021, International Convention Center Jeju and Jeju Booyoung Hotel \& Resort, Seogwipo, Republic of Korea.},
  url = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE10563711},
  abstract = {This  paper  presents  a  Model-Predictive  Control  (MPC)  study  applied  to  a  heating  system  in  a  large  open  factory  building  in  Incheon,  South Korea.  Rather  than  resorting  to  a  full-blown  dynamic  simulation  model,  this  study  takes  a  lumped  minimalistic  approach  for  the  prediction indoor  air  temperatures  in  the  building.  It  was  found  that  the  lumped  simulation  model  is  accurate  enough  and  applicable  to  the  MPC  for the  building,  leading  to  energy  savings  by  52\%.},
  keywords = {machine learning; artificial neural network; factory energy management system; model predictive control; simulation model}
}

