@inproceedings{publication-2020-1u9xglb,
  title = {Development of EnergyPlus parser based on geographic information system},
  author = {Lee, D. H. and Ko, Y. D. and Yoo, Y. S. and Jo, H. G. and Kim, D. W. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, pp. 81-82. Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, 2020, November 19-21, 2020, Architecture Building, Korea National University of Transportation, Chungju, Republic of Korea; hybrid.},
  url = {https://www.auric.or.kr/user/rdoc/DocRdoc.aspx?dn=400683&returnVal=RD_R},
  abstract = {Urban-scale building energy simulation is important because it can be used for energy policy, building retrofit decision making, smart-grid optimization, peak load prediciton, etc. This study resports the development of EnergyPlus parser based on the geographic information system (GIS). The purpose of this paper is to address issues in the process of converting GIS data into dynamic building energy simulation (EnergyPlus), and to share the lessons learned from this work.},
  keywords = {urban-scale building energy simulation; geographic information system; parser; python}
}

@inproceedings{publication-2020-tcwwkf,
  title = {Prediction of Illuminance Ratios between Points using Gaussian Process},
  author = {Jo, H. G. and Shin, H. S. and Kim, Y. S. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, pp. 153-154. Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, 2020, November 19-21, 2020, Architecture Building, Korea National University of Transportation, Chungju, Republic of Korea; hybrid.},
  url = {https://www.auric.or.kr/User/Rdoc/DocRdoc.aspx?dn=400711&returnVal=RD_R},
  abstract = {This paper suggests a methodology for predicting illuminance using Gaussian Process model. Based on one-point measured illuminance data, the authors developed Gaussian Process model which can predict an illuminance ratio between a reference point and points in interest. The Gaussian Process model uses solar altitude and azimuth as inputs. This approach was tested at a mechanical factory building for ten days. It is found that illuminance ratio changes with solar altitude and azimuth, and combination of Gaussian Process and one-point sensor data could describe indoor illuminances with a distribution of errors.},
  keywords = {daylit illuminance prediction; solar altitude; azimuth; gaussian process}
}

@inproceedings{publication-2020-1kl7pzp,
  title = {Repeatability of Monthly Energy Use for 10,750 buildings},
  author = {Ko, Y. D. and Lee, D. H. and Yoo, Y. S. and Jo, H. G. and Kim, D. W. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, pp. 145-146. Fall Conference of the Korean Institute of Architectural Sustainable Environment and Building Systems, 2020, November 19-21, 2020, Architecture Building, Korea National University of Transportation, Chungju, Republic of Korea; hybrid.},
  url = {https://www.auric.or.kr/user/rdoc/DocRdoc.aspx?dn=400708&returnVal=RD_R},
  abstract = {Although numerous studies have been conducted on performance gap between predicted and measured energy uses, there is a significant lack of evidence regarding whether monthly energy use of each building repeats over time. This study aims to evaluate the repeatability of monthly energy use of 10,750 buildings for three years (2017-2019). It is assumed that the higher CVRMSE of building’s monthly energy use between a pair of years is, the less repeatable a building is, leading to being less predictable. K-means algorithm was used to extract representative energy use patterns of the buildings, and four energy use patterns were identified. It is noteworthy that 9,760 (90.8\%) buildings do not satisfy the monthly criteria of ASHRAE Guideline (CVRMSE≤0.15), which means their three years’ monthly energy use pattern do not repeat. This signifies that it might be difficult to predict the energy use of those buildings. In addition, it was found that there is a distinct difference of CVRMSE (i.e., the degree of unpredictability) among four energy
use patterns (0.27, 0.28 vs. 0.38, 0.40 on average), whereas there is little difference among seven building use types (0.27-0.31 on average).},
  keywords = {building energy use; repeatability; energy use pattern; clustering}
}

@inproceedings{publication-2020-1sa6qgg,
  title = {Classification of Building Energy Pattern based on Robust Regression and Time series clustering},
  author = {Lee, D. H. and Yoo, Y. S. and Ko, Y. D. and Jo, H. G. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Architectural Institute of Korea, Vol. 40, No. 2, pp. 392-393. Fall Annual Conference of the Architectural Institute of Korea, 2020, October 26-30, 2020, Yeosu Expo Convention Center, Yeosu, Republic of Korea; online presentation.},
  url = {https://www.auric.or.kr/user/rdoc/DocRdoc.aspx?dn=400990&returnVal=RD_R},
  abstract = {For efficient energy management of building stocks, it is important to classify building energy pattern where dominant design variablescould be identified. In this regard, the authors present a classification method of building energy pattern using RANSAC (robust regression)and K-shape algorithm (time series clustering). A reference office building was chosen and populated using the Sobol sequence method,resulting in 1,000 samples. Energy use data of 1,000 sample buildings were obtained from EnergyPlus simulations. The relationship betweenoutdoor temperature and building energy use was selected as building energy pattern. It is shown that 1,000 buildings can be classified intotwo clusters (heating dominant vs. cooling dominant) and corresponding four architectural design variables.},
  keywords = {building energy; energy pattern classification; robust regression; time series clustering}
}

@inproceedings{publication-2020-n4r9hp,
  title = {Data-Driven Methodology to Indentify Building Properties for Building Energy Performance Benchmarking},
  author = {Ko, Y. D. and Lee, D. H. and Yoo, Y. S. and Jo, H. G. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Architectural Institute of Korea, Vol. 40, No. 2, pp. 384-385. Fall Annual Conference of the Architectural Institute of Korea, 2020, October 26-30, 2020, Yeosu Expo Convention Center, Yeosu, Republic of Korea; online presentation.},
  url = {https://www.auric.or.kr/user/rdoc/DocRdoc.aspx?dn=400986&returnVal=RD_R},
  abstract = {Due to the lack of detailed building energy data (e.g. thermal properties of building envelopes, efficiencies of HVAC systems, hourlysub-metered energy data etc.), most of existing building energy benchmarking systems have used EUI (Energy Use Intensity, kWh/m2·yr) peruse type (office, school, etc). However, the EUI-based approach is closer to ‘energy use becnhmarking’ than ‘energy performancebenchmarking’. In this regard, this study aims to present a data-driven methodology to identify building’s thermal characteristics frommonthly energy use data, which will lead to objective performance comparison among buildings. In this study, ANN(Artifical NeuralNetwork) was utlized for the inverse identification and virtual traning data were generated from 10,000 samples of an EnergyPlus model byLHS. The ANN was validated with 14 existing buildings (CVRMSE 17.6\%). This proposed approach will provide identification of theaforementioned unmeasured/uncertain thermal characteristics and will be used for objective performance comparison},
  keywords = {building energy benchmakring; builidng performance; artificial neural network; identification}
}

@inproceedings{publication-2020-1bouwhl,
  title = {Optimal control of artificial lighting with Deep Deterministic Policy Gradient(DDPG)},
  author = {Kim, Y. S. and Jo, H. G. and Shin, H. S. and Park, C. S.},
  year = {2020},
  booktitle = {Proceedings of the Fall Conference of the Architectural Institute of Korea, Vol. 40, No. 2, pp. 382-383. Fall Annual Conference of the Architectural Institute of Korea, 2020, October 26-30, 2020, Yeosu Expo Convention Center, Yeosu, Republic of Korea; online presentation.},
  url = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE10518762},
  abstract = {It  is  difficult  to  find  optimal  control  variables  for  lighting  system  in  an  existing  building  because  the  luminous  environment  is  influenced  by daylighting  that  continuously  vary  over  the  course  of  a  day.  In  addition,  the  luminous  environment  is  also  interplayed  with  (dimmable) electric  lighting.  Many  existing  optimization  algorithms  require  significant  effort  to  develop  an  accurate  simulation  model  as  well  as demanding  computation  time.  Recently,  reinforcement  learning  has  been  applied  to  complex  control  problems.  In  this  study,  DDPG  (Deep Deterministic  Policy  Gradient)  is  applied  to  dimmable  electric  lighting  system  in  an  existing  building.  It  is  shown  that  DDPG  can  be  used for  real-time  optimal  control  of  the  lighting  system  and  can  save  about  30\%  of  lighting  energy  without  sacrifcing  luminous  uniformity  of  a given  space},
  keywords = {ddpg; reinforcement learning; diva; illuminance prediction model; electric lighting control; optimal control}
}

